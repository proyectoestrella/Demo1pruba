# Variables de entorno de siShow. Copia a .env.local (ignorado por git) en
# desarrollo; en Vercel van en Settings > Environment Variables (Production y
# Preview). NUNCA valores aquí ni en ningún fichero del repositorio.
#
# En producción, si falta SUPABASE_URL o SUPABASE_SERVICE_ROLE_KEY, un salón
# de pago YA NO se comporta como demo en silencio: getSalonProfile lanza
# «Backend sin configurar», la web pública bloquea la reserva y el panel
# avisa. En desarrollo sin variables todo sigue siendo demo, como siempre.

# Server-only — never prefix these with VITE_ (that would ship them to the browser).
# Get both from the Supabase project: Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Públicas: viajan al navegador a propósito. Las necesita Supabase Auth para el
# enlace mágico del panel. Vite solo expone al navegador lo que empieza por
# VITE_, de ahí el prefijo. Son las mismas que Supabase llama "Project URL" y
# "anon/public key" (Settings > API). NO son secretos: la service role key, que
# sí lo es, sigue arriba y sin prefijo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fotos de la ficha de Google Places para las demos (/api/foto y maps.functions).
# Server-only. Sin ella las demos usan la foto de ejemplo de la app.
GOOGLE_MAPS_API_KEY=

# Recordatorio automático por email el día anterior (server-only, sin VITE_).
# Proveedor: Resend (https://resend.com, plan gratuito). Sin las dos primeras
# no se envía nada y /api/recordatorios responde "sin-proveedor".
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Secreto que Vercel manda como `Authorization: Bearer` al cron de
# /api/recordatorios (vercel.json). Sin él la ruta responde 401 siempre.
CRON_SECRET=
